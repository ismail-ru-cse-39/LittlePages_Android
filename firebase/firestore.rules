rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Storefront metadata is public. Only immutable published revisions are stored here;
    // trusted publishing uses the Admin SDK, which is not governed by client rules.
    match /publicConfiguration/{documentId} {
      allow get: if documentId == 'current';
      allow list, write: if false;
    }

    match /configurationRevisions/{revisionId} {
      allow get: if revisionId.matches('^[1-9][0-9]*$');
      allow list, write: if false;
    }

    match /catalogRevisions/{revisionId}/products/{productId} {
      allow get, list: if revisionId.matches('^[1-9][0-9]*$');
      allow write: if false;
    }

    // All user, staff, draft, payment, entitlement, moderation, and other data stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
