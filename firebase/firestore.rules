rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Storefront metadata is public. Only immutable published revisions are stored here;
    // trusted publishing uses the Admin SDK, which is not governed by client rules.
    match /publicConfiguration/{documentId} {
      allow get: if documentId == 'current';
      allow list, write: if false;
    }

    match /configurationRevisions/{revisionId} {
      allow get: if revisionId.matches('^[1-9][0-9]*$');
      allow list, write: if false;
    }

    match /catalogRevisions/{revisionId}/products/{productId} {
      allow get, list: if revisionId.matches('^[1-9][0-9]*$');
      allow write: if false;
    }

    // Published automatic discounts and banner content are public catalogue data.
    // Discount-code hashes, customer assignments, and redemption records stay denied below.
    match /catalogRevisions/{revisionId}/promotions/{promotionId} {
      allow get, list: if revisionId.matches('^[1-9][0-9]*$');
      allow write: if false;
    }

    // Parents may read only their own server-created child profiles for account UI and access selection.
    // Profile writes remain server-only; callable functions independently verify ownership.
    match /users/{uid}/children/{childId} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Staff, drafts, payments, entitlements, moderation, and all other user data stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
